---
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { SITE } from '@/config/site';
import { getBuildVersion } from '@/integrations/build-version';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** When true the title is used verbatim instead of having the site name appended. */
  bareTitle?: boolean;
  /** Hide chrome — used by the printable certificate. */
  chrome?: boolean;
}

const { title, description = SITE.description, bareTitle = false, chrome = true } = Astro.props;

const pageTitle = bareTitle ? title : `${title} — ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;

// Resolved once for the whole build; see src/integrations/build-version.ts.
const buildVersion = getBuildVersion();
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Which build served this page. A meta tag rather than anything visible: the
      audience is shop owners, and a version string in the chrome is noise to them and
      to nobody's benefit. In `view-source` it is the second line of the head, and
      `document.querySelector('meta[name="build-version"]').content` reads it from a
      console, which covers debugging a report. Living in BaseLayout puts it on every
      route without anyone having to remember it. See src/integrations/build-version.ts.
    -->
    <meta name="build-version" content={buildVersion} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <meta name="theme-color" content="#0f6b47" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />

    <!--
      Preconnect only to the thumbnail CDN. The video origin is deliberately not
      preconnected: no connection to YouTube is opened until the learner presses
      play on the facade.
    -->
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin />
  </head>

  <body class="flex min-h-screen flex-col">
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    {chrome && <SiteHeader />}

    <main id="conteudo" class="flex-1">
      <slot />
    </main>

    {chrome && <SiteFooter />}

    <script>
      import { initProgressUi } from '@/scripts/progress-ui';

      initProgressUi();
    </script>

    <script>
      // Offline support. Registration is deliberately best-effort: a failure here
      // must never affect the page, and the site works fine without it.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          void (async () => {
            try {
              await navigator.serviceWorker.register('/sw.js');
              const registration = await navigator.serviceWorker.ready;
              // The first navigation is not intercepted by a worker that did not
              // exist yet, so ask it to cache this page explicitly. Without this,
              // the lesson you are reading right now would not survive going
              // offline until you visited it a second time.
              registration.active?.postMessage({
                type: 'cache-page',
                url: window.location.href,
              });
            } catch {
              /* offline support unavailable — not worth surfacing to a learner */
            }
          })();
        });
      }
    </script>
  </body>
</html>
