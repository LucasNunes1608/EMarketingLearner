---
import VideoPlayer from '@/components/VideoPlayer.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  coursePath,
  formatDuration,
  getAdjacentLessons,
  getLessonsForCourse,
  getPublishedCourses,
  lessonPath,
  lessonSlug,
} from '@/lib/content';
import { loadContent } from '@/lib/content-loader';
import { type CollectionEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const { courses, lessons, worksheets } = await loadContent();

  return getPublishedCourses(courses).flatMap((course) => {
    const courseLessons = getLessonsForCourse(lessons, course.id);

    return courseLessons.map((lesson) => ({
      params: { curso: course.id, aula: lessonSlug(lesson) },
      props: {
        course,
        lesson,
        courseLessons,
        worksheet: worksheets.find((w) => w.id === lesson.data.worksheet) ?? null,
      },
    }));
  });
}

// Pages carry Astro's full CollectionEntry because render() needs the `collection`
// and `rendered` fields. The helpers in @/lib/content take a narrower structural
// type, which CollectionEntry satisfies — that is what keeps them unit-testable.
interface Props {
  course: CollectionEntry<'courses'>;
  lesson: CollectionEntry<'lessons'>;
  courseLessons: CollectionEntry<'lessons'>[];
  worksheet: CollectionEntry<'worksheets'> | null;
}

const { course, lesson, courseLessons, worksheet } = Astro.props;

const slug = lessonSlug(lesson);
const { previous, next } = getAdjacentLessons(courseLessons, slug);
const position = courseLessons.findIndex((l) => lessonSlug(l) === slug) + 1;

// Astro 5 renders a collection entry's body through render(), not entry.render().
const { Content } = await render(lesson);
---

<BaseLayout title={lesson.data.title} description={lesson.data.summary}>
  <article class="mx-auto max-w-3xl px-4 py-8" data-lesson={slug} data-lesson-course={course.id}>
    <nav aria-label="Trilha de navegação" class="text-sm">
      <ol class="flex flex-wrap items-center gap-2 text-ink-500">
        <li><a class="text-brand-700 underline underline-offset-2" href="/">Início</a></li>
        <li aria-hidden="true">/</li>
        <li>
          <a class="text-brand-700 underline underline-offset-2" href={coursePath(course.id)}>
            {course.data.title}
          </a>
        </li>
      </ol>
    </nav>

    <header class="mt-5">
      <p class="text-sm font-semibold text-brand-700">
        Aula {position} de {courseLessons.length} · {formatDuration(lesson.data.durationSeconds)}
      </p>
      <h1 class="mt-2 text-3xl font-bold text-ink-900">{lesson.data.title}</h1>
      <p class="mt-3 text-lg text-ink-700">{lesson.data.summary}</p>
    </header>

    <div class="mt-6">
      <VideoPlayer source={lesson.data.video} title={lesson.data.title} />
    </div>

    {/* Toggled by the progress script; starts in the "not done" state for no-JS users. */}
    <div class="mt-5 flex flex-wrap items-center gap-3">
      <button
        type="button"
        data-toggle-complete
        aria-pressed="false"
        class="rounded-lg border-2 border-brand-700 bg-brand-700 px-5 py-2.5 font-semibold text-white hover:bg-brand-800"
      >
        <span data-complete-label>Marcar aula como concluída</span>
      </button>
      <p class="text-sm text-ink-500" data-complete-hint>Fica salvo só neste aparelho.</p>
    </div>

    <div class="prose mt-8">
      <Content />
    </div>

    {
      worksheet && (
        <aside class="mt-10 rounded-xl border border-brand-200 bg-brand-50 p-5">
          <h2 class="text-lg font-bold text-brand-900">Folha de exercício</h2>
          <p class="mt-1 text-ink-700">
            Imprima ou responda pelo celular. Dá para mandar no WhatsApp de quem trabalha com você.
          </p>
          <a
            href={`/ficha/${worksheet.id}`}
            class="mt-3 inline-block rounded-lg bg-brand-700 px-4 py-2 font-semibold text-white no-underline hover:bg-brand-800"
          >
            Abrir a folha de exercício
          </a>
        </aside>
      )
    }

    <nav aria-label="Navegação entre aulas" class="mt-10 border-t border-ink-100 pt-6">
      <ul class="flex flex-wrap justify-between gap-4">
        <li class="min-w-0">
          {
            previous && (
              <a
                class="text-brand-700 no-underline hover:underline"
                href={lessonPath(course.id, lessonSlug(previous))}
                rel="prev"
              >
                <span class="block text-xs text-ink-500">Aula anterior</span>
                <span class="font-semibold">← {previous.data.title}</span>
              </a>
            )
          }
        </li>
        <li class="min-w-0 sm:text-right">
          {
            next ? (
              <a
                class="text-brand-700 no-underline hover:underline"
                href={lessonPath(course.id, lessonSlug(next))}
                rel="next"
              >
                <span class="block text-xs text-ink-500">Próxima aula</span>
                <span class="font-semibold">{next.data.title} →</span>
              </a>
            ) : (
              <a class="text-brand-700 no-underline hover:underline" href={coursePath(course.id)}>
                <span class="block text-xs text-ink-500">Última aula</span>
                <span class="font-semibold">Voltar para o curso →</span>
              </a>
            )
          }
        </li>
      </ul>
    </nav>
  </article>
</BaseLayout>
