---
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  coursePath,
  formatDuration,
  getCourseDurationSeconds,
  getLessonsForCourse,
  getPublishedCourses,
} from '@/lib/content';
import { loadContent } from '@/lib/content-loader';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const { courses, lessons } = await loadContent();
  return getPublishedCourses(courses).map((course) => {
    const courseLessons = getLessonsForCourse(lessons, course.id);
    return {
      params: { curso: course.id },
      props: {
        course,
        lessonCount: courseLessons.length,
        duration: formatDuration(getCourseDurationSeconds(courseLessons)),
      },
    };
  });
}

interface Props {
  course: CollectionEntry<'courses'>;
  lessonCount: number;
  duration: string;
}

const { course, lessonCount, duration } = Astro.props;
---

<BaseLayout
  title={`Certificado — ${course.data.title}`}
  description={`Certificado de conclusão do curso ${course.data.title}.`}
>
  <div
    class="mx-auto max-w-3xl px-4 py-8"
    data-certificate
    data-course={course.id}
    data-course-total={lessonCount}
  >
    {
      /*
      Server-rendered default is the "not finished yet" state. The certificate is
      revealed by script only once stored progress shows every lesson complete —
      so the page never briefly flashes a certificate the learner has not earned.
    */
    }
    <section data-certificate-locked aria-live="polite">
      <h1 class="text-2xl font-bold text-ink-900">Certificado ainda não liberado</h1>
      <p class="mt-3 text-ink-700">
        Conclua todas as {lessonCount} aulas do curso <strong>{course.data.title}</strong> para emitir
        o seu certificado. Marque cada aula como concluída conforme for assistindo.
      </p>
      <a
        class="mt-5 inline-block rounded-lg bg-brand-700 px-5 py-2.5 font-semibold text-white no-underline hover:bg-brand-800"
        href={coursePath(course.id)}
      >
        Voltar para o curso
      </a>
    </section>

    <section data-certificate-unlocked hidden>
      <div class="no-print">
        <h1 class="text-2xl font-bold text-ink-900">Seu certificado está pronto</h1>
        <p class="mt-2 text-ink-700">
          Escreva seu nome como quer que apareça no certificado e depois use o botão para imprimir
          ou salvar em PDF.
        </p>

        <div class="mt-4 flex flex-wrap items-end gap-3">
          <div class="grow">
            <label class="block text-sm font-semibold text-ink-900" for="nome-certificado">
              Seu nome completo
            </label>
            <input
              id="nome-certificado"
              type="text"
              autocomplete="name"
              placeholder="Ex.: Maria da Silva"
              data-certificate-name-input
              class="mt-1 w-full rounded-lg border border-ink-300 px-3 py-2 text-ink-900"
            />
          </div>
          <button
            type="button"
            data-print
            class="rounded-lg bg-brand-700 px-5 py-2.5 font-semibold text-white hover:bg-brand-800"
          >
            Imprimir ou salvar em PDF
          </button>
        </div>
        <p class="mt-2 text-sm text-ink-500">
          O nome fica salvo apenas neste aparelho, junto com o seu progresso.
        </p>
      </div>

      <!-- The printable artefact. -->
      <div class="certificate mt-8" role="group" aria-label="Prévia do certificado">
        <div class="certificate__inner">
          <p class="certificate__brand">{SITE.name}</p>
          <p class="certificate__kicker">Certificado de conclusão</p>
          <p class="certificate__intro">Certificamos que</p>
          <p class="certificate__name" data-certificate-name></p>
          <p class="certificate__intro">concluiu o curso</p>
          <p class="certificate__course">{course.data.title}</p>
          <p class="certificate__meta">
            {lessonCount} aulas · {duration} de conteúdo
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /*
   * The certificate is drawn in CSS and printed through the browser's own dialog.
   * No PDF library is bundled: jsPDF would add ~350 KB to a page served to people
   * on mobile data, to do something window.print() already does everywhere.
   */
  .certificate {
    border: 3px double var(--color-brand-700);
    border-radius: 0.5rem;
    background: #fff;
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .certificate__inner {
    border: 1px solid var(--color-brand-200);
    border-radius: 0.25rem;
    padding: 2rem 1rem;
  }

  .certificate__brand {
    font-weight: 700;
    color: var(--color-brand-700);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }

  .certificate__kicker {
    margin-top: 0.75rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-brand-900);
  }

  .certificate__intro {
    margin-top: 1.5rem;
    color: var(--color-ink-500);
  }

  .certificate__name {
    margin-top: 0.25rem;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-ink-900);
    border-bottom: 1px solid var(--color-ink-300);
    display: inline-block;
    min-width: 60%;
    min-height: 1.3em;
    padding-bottom: 0.25rem;
  }

  .certificate__course {
    margin-top: 0.25rem;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-brand-800);
  }

  .certificate__meta {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--color-ink-500);
  }

  @media print {
    @page {
      size: A4 landscape;
      margin: 12mm;
    }

    :global(header),
    :global(footer),
    .no-print {
      display: none !important;
    }

    .certificate {
      margin: 0;
      border-width: 4px;
    }
  }
</style>

<script>
  import { isCourseComplete } from '@/lib/progress';
  import { getBrowserStorage, loadProgress, saveProgress } from '@/lib/progress-store';
  import { setLearnerName } from '@/lib/progress';

  const root = document.querySelector<HTMLElement>('[data-certificate]');
  if (root) {
    const course = root.dataset.course ?? '';
    const total = Number(root.dataset.courseTotal ?? '0');

    const storage = getBrowserStorage();
    let state = loadProgress(storage);

    if (isCourseComplete(state, course, total)) {
      const locked = root.querySelector<HTMLElement>('[data-certificate-locked]');
      const unlocked = root.querySelector<HTMLElement>('[data-certificate-unlocked]');
      if (locked) locked.hidden = true;
      if (unlocked) unlocked.hidden = false;

      const input = root.querySelector<HTMLInputElement>('[data-certificate-name-input]');
      const output = root.querySelector<HTMLElement>('[data-certificate-name]');

      const paint = (value: string) => {
        // A non-breaking space keeps the signature rule from collapsing when empty.
        if (output) output.textContent = value.trim();
      };

      if (input && state.name) {
        input.value = state.name;
        paint(state.name);
      }

      input?.addEventListener('input', () => {
        paint(input.value);
        state = setLearnerName(state, input.value);
        saveProgress(storage, state);
      });
    }
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (target?.closest('[data-print]')) window.print();
  });
</script>
